# Copy this file to .env (or set these as environment variables on your host)

# Required: your Anthropic API key, from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: which Claude model to use (defaults to a stable Sonnet model)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Optional: your studio's name, used in the AI's system prompt
# STUDIO_NAME=Dance Lead Machine Studio

# Optional: port to listen on (most hosts set this for you automatically)
# PORT=3000

# Optional: where the SQLite database file lives (defaults to ./data/dance_lead_machine.db)
# DB_PATH=./data/dance_lead_machine.db
